# Backend configuration
BACKEND_URL=https://localhost:8080
FRONTEND_URL=https://localhost:3000

# MongoDB configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/competitive-coding-platform

# GitHub OAuth configuration
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=https://localhost:8080/auth/github/callback

# JWT Secret for token generation
JWT_SECRET=your_jwt_secret_here_change_in_production

# Server Port
PORT=8080

# Environment
ENVIRONMENT=development

# Resend Email Configuration (for password reset emails and admin broadcasts)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=CODEMASTER
APP_LOGO_URL=https://yourdomain.com/logo.png

# Broadcast test mode (optional)
# Set to "true" to enable test mode: broadcast emails will only be sent to admin users or addresses in TEST_EMAIL_RECIPIENTS
# Default is "false" (production mode - sends to all target users)
BROADCAST_TEST_MODE=false

# Test email recipients for broadcast test mode (optional)
# Comma-separated list of email addresses to receive test broadcasts when BROADCAST_TEST_MODE=true
# Example: "admin1@example.com,admin2@example.com,test@example.com"
# If not set, test mode will send only to admin users (role=admin or super_admin)
TEST_EMAIL_RECIPIENTS=

# Frontend URL for password reset links
FRONTEND_BASE_URL=https://localhost:3000
